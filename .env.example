# ===== 前端（word-battle-app 根目录）=====

# Java 后端地址。不配置时前端自动进入内存 mock 演示模式。
NEXT_PUBLIC_JAVA_API_URL="http://localhost:8080"

# ===== Java 后端（环境变量覆盖，默认值见 backend-java/src/main/resources/application.yml）=====

# JWT 签名密钥（生产环境必须更换为强随机值，至少 32 字符）
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars-please"

# 数据源（Docker Compose 中由 SPRING_DATASOURCE_URL 等环境变量注入）
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/word_battle"
SPRING_DATASOURCE_USERNAME="postgres"
SPRING_DATASOURCE_PASSWORD="postgres"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# LLM 词库富化（火山方舟，可选；不配置不影响其他功能）
LLM_API_KEY=""
LLM_BASE_URL="https://ark.cn-beijing.volces.com/api/coding/v3"
LLM_MODEL="glm-5.2"
